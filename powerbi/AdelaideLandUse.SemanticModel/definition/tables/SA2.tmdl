table SA2
	lineageTag: 098bc0ff-5209-6e26-0be0-66740679b40c

	/// Approved residential allotments lodged 1 July 2018 to 30 June 2025
	measure Allotments = SUM ( SA2[all_lots] )
		formatString: #,0
		lineageTag: fde1463b-1b2a-8299-b88b-12eb56c0c6a2

	/// On land that was farmland, vacant land or rural living in 2018
	measure 'Greenfield allotments' = SUM ( SA2[greenfield] )
		formatString: #,0
		lineageTag: 0326a674-2807-57d5-a94a-05548e2e9bbb

	/// On land already residential in 2018
	measure 'Infill allotments' = SUM ( SA2[infill] )
		formatString: #,0
		lineageTag: 3d5f8d54-40d2-4874-525a-3dfe1a2f52ba

	measure 'Greenfield share' = DIVIDE ( [Greenfield allotments], [Allotments] )
		formatString: 0%
		lineageTag: 6a010849-567c-b9a7-46b3-2fd396e08176

	measure 'Infill share' = DIVIDE ( [Infill allotments], [Allotments] )
		formatString: 0%
		lineageTag: 24348b74-2619-5abc-1222-2d37a3aeb152

	/// Farm, vacant or rural-living land in 2018 that is residential in 2025, with a residential land division over it
	measure 'Greenfield hectares' = SUM ( SA2[greenfield_ha] )
		formatString: #,0
		lineageTag: 1c02ce92-fda4-b1b3-3a32-3c57c5165663

	column sa2_code
		dataType: string
		lineageTag: 14e4c328-9429-7f0c-5768-964dbf74b9a6
