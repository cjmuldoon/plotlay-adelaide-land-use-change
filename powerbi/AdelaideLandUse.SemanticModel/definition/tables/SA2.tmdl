	partition SA2 = m
		mode: import
		source =
				let
				    Source = Csv.Document(GetFile("tables/by_sa2.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Kept = Table.SelectColumns(Promoted, {"sa2_code", "sa2_name", "Greenfield", "Infill", "Vacant residential land", "Brownfield and other", "all_lots", "greenfield_ha", "recoded_ha"}),
				    Typed = Table.TransformColumnTypes(Kept, {{"sa2_code", type text}, {"sa2_name", type text}, {"Greenfield", type number}, {"Infill", type number}, {"Vacant residential land", type number}, {"Brownfield and other", type number}, {"all_lots", type number}, {"greenfield_ha", type number}, {"recoded_ha", type number}}, "en-US")
				    Renamed = Table.RenameColumns(Typed, {{"Greenfield", "greenfield"}, {"Infill", "infill"}, {"Vacant residential land", "vacant_urban"}, {"Brownfield and other", "brownfield"}, {"Not in the 2018 layer", "no_parcel"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
